{
  "name": "orca",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint:biome",
    "lint:biome": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:comments": "node scripts/lint-comments.mjs",
    "lint:comments:update": "node scripts/lint-comments.mjs --update",
    "format": "biome format --write .",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "turbo": "^2.11.13",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
